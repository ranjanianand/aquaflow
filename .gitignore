# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude/AI assistant files
.claude/

# Documentation and presentation files (local only)
UIUX-IMPROVEMENTS.md
docs/
feature-overview.html
**/public/presentation.html
nul

# local verification scripts
.chk.mjs
.menu.mjs
.verify*.mjs
.pdf*.mjs

# Anchors are deliberately absent above: the dashboard lives in frontend/
# and the API in backend/, so these must match at any depth.

# ── backend ─────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Airflow writes these at runtime; they are not source.
airflow/logs/
airflow/*.cfg
airflow/*.db
airflow/simple_auth_manager_passwords.json.generated

# Raw data files and the gateway rig are deliberately excluded — they are
# large, regenerable, and belong in their own place rather than in the
# application repository.
